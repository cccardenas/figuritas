{
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run server:dev\" \"npm run web:dev\"",
    "web:dev": "vite --host 0.0.0.0",
    "server:dev": "node server/index.js",
    "start": "node server/index.js",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.22.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-core": "^1.59.1"
  }
}
